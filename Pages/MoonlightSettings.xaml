<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:moonlight_xbox_dx" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="moonlight_xbox_dx.MoonlightSettings" mc:Ignorable="d" PreviewKeyDown="Page_PreviewKeyDown" XYFocusKeyboardNavigation="Enabled" Background="{StaticResource OrbitBackgroundBrush}">
    <Page.Resources>
        <SolidColorBrush x:Key="SettingsCardBrush" Color="#D9141416"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardFocusedBrush" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardFocusedBorderBrush" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="SettingsSectionSelectedBrush" Color="#33FFFFFF"/>
        <!-- Section list: plain labels; the open section is a soft pill, outlined while focused -->
        <Style x:Key="SettingsSectionButtonStyle" TargetType="Button" BasedOn="{StaticResource OrbitRowButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <!-- Option card: dark glass; MoonlightSettings lights up the card holding focus -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="50"/>
        </Style>
        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource OrbitTextBrush}"/>
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource OrbitTextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsIntroStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Foreground" Value="{StaticResource OrbitTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource OrbitComboBoxStyle}">
            <Setter Property="Width" Value="220"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="220"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OrbitFocusBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OrbitFocusBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OrbitFocusBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
    </Page.Resources>
    <Grid local:OrbitMotion.Kind="Page">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#FF1B3B8A" Offset="0" />
                    <GradientStop Color="#FF0B1530" Offset="0.35" />
                    <GradientStop Color="#FF000000" Offset="0.75" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Interface size: AttachUiScale sizes the content, the Viewbox scales it to fit -->
        <Viewbox Stretch="Fill">
        <Grid x:Name="ScaledRoot">
        <Grid Margin="32,20,32,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Top bar: tabs centred between the bumpers, clock on the right -->
            <Grid Margin="0,-2,0,22">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <ContentControl Style="{StaticResource OrbitKeyLBStyle}" Margin="0,0,6,0" />
                    <Button x:Name="backButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Hosts" Click="backButton_Click" />
                    <Button x:Name="settingsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Settings" Background="{StaticResource OrbitTabSelectedBrush}" Foreground="{StaticResource OrbitTabSelectedTextBrush}" />
                    <ContentControl Style="{StaticResource OrbitKeyRBStyle}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource OrbitTextBrush}" />
            </Grid>
            <TextBlock Grid.Row="1" Text="App settings" FontSize="34" FontWeight="SemiLight" Foreground="{StaticResource OrbitTextBrush}" Margin="0,0,0,30"/>
            <Grid Grid.Row="2" ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6" Margin="-18,0,0,0">
                    <Button x:Name="GeneralSectionButton" Style="{StaticResource SettingsSectionButtonStyle}" Content="General" GotFocus="SectionButton_GotFocus" Click="SectionButton_GotFocus" XYFocusRight="{x:Bind HostSelector}" Background="{StaticResource SettingsSectionSelectedBrush}" Foreground="{StaticResource OrbitTextBrush}"/>
                    <Button x:Name="DisplaySectionButton" Style="{StaticResource SettingsSectionButtonStyle}" Content="Display" GotFocus="SectionButton_GotFocus" Click="SectionButton_GotFocus" XYFocusRight="{x:Bind UiScaleSelector}"/>
                    <Button x:Name="InputSectionButton" Style="{StaticResource SettingsSectionButtonStyle}" Content="Input" GotFocus="SectionButton_GotFocus" Click="SectionButton_GotFocus" XYFocusRight="{x:Bind MouseSensitivitySlider}"/>
                </StackPanel>
                <Grid Grid.Column="1" MaxWidth="560" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SectionTitle" Text="General" FontSize="22" Foreground="{StaticResource OrbitTextBrush}" Margin="6,0,0,4"/>
                    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" IsTabStop="False" Padding="6,4,10,6">
                        <Grid>
                            <StackPanel x:Name="GeneralPanel" Spacing="8" Visibility="Visible">
                                <TextBlock Style="{StaticResource SettingsIntroStyle}" Margin="0,0,0,10" Text="Resolution, frame rate and bitrate are set per PC: press Y in a PC's library to change them."/>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Autostart host"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="HostSelector" SelectionChanged="HostSelector_SelectionChanged" XYFocusLeft="{x:Bind GeneralSectionButton}" AutomationProperties.Name="Autostart host"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Welcome wizard"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Button x:Name="WelcomeButton" Click="WelcomeButton_Click" XYFocusLeft="{x:Bind GeneralSectionButton}" AutomationProperties.Name="Open Welcome Wizard" Style="{StaticResource OrbitPillButtonStyle}" FontSize="15" Padding="16,8" HorizontalAlignment="Right">Open Welcome Wizard</Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Navigation sounds"/>
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Play the console's sounds when moving focus and selecting."/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="NavigationSoundsToggle" IsOn="{x:Bind State.NavigationSounds,Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" XYFocusLeft="{x:Bind GeneralSectionButton}" AutomationProperties.Name="Navigation sounds"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="DisplayPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsIntroStyle}" Margin="0,0,0,10" Text="Your TV may crop the edges of the picture. Adjust the margins until the whole white outline and its corner marks are visible."/>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Interface size"/>
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Size of the menus. The stream itself is not affected."/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="UiScaleSelector" SelectionChanged="UiScaleSelector_SelectionChanged" XYFocusLeft="{x:Bind DisplaySectionButton}" AutomationProperties.Name="Interface size">
                                                <ComboBoxItem Content="Large (100%)" Tag="100"/>
                                                <ComboBoxItem Content="Medium (90%)" Tag="90"/>
                                                <ComboBoxItem Content="Small (80%)" Tag="80"/>
                                            </ComboBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Screen margin height"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Slider Value="{x:Bind State.ScreenMarginHeight}" x:DefaultBindMode="TwoWay" Minimum="0" Maximum="100" StepFrequency="1" x:Name="ScreenMarginHeightSlider" XYFocusLeft="{x:Bind DisplaySectionButton}" AutomationProperties.Name="Screen margin height"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Screen margin width"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Slider Value="{x:Bind State.ScreenMarginWidth}" x:DefaultBindMode="TwoWay" Minimum="0" Maximum="100" StepFrequency="1" XYFocusLeft="{x:Bind DisplaySectionButton}" AutomationProperties.Name="Screen margin width"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Use for menus too"/>
                                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Also inset the Hosts, Library and Settings screens. The stream always uses the margin."/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="MenuSafeAreaToggle" IsOn="{x:Bind State.MenuSafeArea,Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" XYFocusLeft="{x:Bind DisplaySectionButton}" AutomationProperties.Name="Use the screen margin for menus"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="InputPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource SettingsIntroStyle}" Margin="0,0,0,10" Text="How the controller drives the mouse and keyboard on your PC while streaming."/>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Mouse sensitivity"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Slider Value="{x:Bind State.MouseSensitivity}" x:DefaultBindMode="TwoWay" Minimum="1" Maximum="16" StepFrequency="1" x:Name="MouseSensitivitySlider" XYFocusLeft="{x:Bind InputSectionButton}" AutomationProperties.Name="Mouse sensitivity"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Experimental keyboard"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch Name="KeyboardEnable" XYFocusRight="{x:Bind KeyboardLayoutSelector}" IsOn="{x:Bind State.EnableKeyboard,Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" XYFocusLeft="{x:Bind InputSectionButton}" AutomationProperties.Name="Experimental keyboard"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Keyboard layout"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="KeyboardLayoutSelector" SelectionChanged="LayoutSelector_SelectionChanged" XYFocusLeft="{x:Bind KeyboardEnable}" AutomationProperties.Name="Keyboard layout"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="18" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ContentControl Style="{StaticResource OrbitKeyAStyle}" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Select"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ContentControl Style="{StaticResource OrbitKeyBStyle}" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Back"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        </Grid>
        </Viewbox>
        <!-- Display area calibration, shown while the Display section is open -->
        <Grid x:Name="CalibrationFrame" Margin="{x:Bind State.CalibrationMargin,Mode=OneWay}" IsHitTestVisible="False" Visibility="Collapsed">
            <Border BorderBrush="#99FFFFFF" BorderThickness="2" />
            <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="6,6,0,0" />
            <Border Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="0,6,6,0" />
            <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="6,0,0,6" />
            <Border Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="0,0,6,6" />
        </Grid>
    </Grid>
</Page>
