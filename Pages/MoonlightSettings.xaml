<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:moonlight_xbox_dx" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="moonlight_xbox_dx.MoonlightSettings" mc:Ignorable="d" PreviewKeyDown="Page_PreviewKeyDown" XYFocusKeyboardNavigation="Enabled" Background="{StaticResource OrbitBackgroundBrush}">
    <Page.Resources>
        <SolidColorBrush x:Key="SettingsSectionSelectedBrush" Color="#33FFFFFF"/>
        <!-- Section list: plain labels; the open section is a soft pill, outlined while focused -->
        <Style x:Key="SettingsSectionButtonStyle" TargetType="Button" BasedOn="{StaticResource OrbitRowButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>
    <Grid local:OrbitMotion.Kind="Page">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#FF1B3B8A" Offset="0" />
                    <GradientStop Color="#FF0B1530" Offset="0.35" />
                    <GradientStop Color="#FF000000" Offset="0.75" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Interface size: AttachUiScale sizes the content, the Viewbox scales it to fit -->
        <Viewbox Stretch="Fill">
        <Grid x:Name="ScaledRoot">
        <Grid Margin="32,20,32,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Top bar: tabs centred between the bumpers, clock on the right -->
            <Grid Margin="0,-2,0,22">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                    <ContentControl Style="{StaticResource OrbitKeyLBStyle}" Margin="0,0,6,0" />
                    <Button x:Name="backButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Hosts" Click="backButton_Click" />
                    <Button x:Name="settingsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Settings" Background="{StaticResource OrbitTabSelectedBrush}" Foreground="{StaticResource OrbitTabSelectedTextBrush}" />
                    <ContentControl Style="{StaticResource OrbitKeyRBStyle}" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource OrbitTextBrush}" />
            </Grid>
            <TextBlock Grid.Row="1" Text="App settings" FontSize="34" FontWeight="SemiLight" Foreground="{StaticResource OrbitTextBrush}" Margin="0,0,0,30"/>
            <Grid Grid.Row="2" ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6" Margin="-18,0,0,0">
                    <Button x:Name="GeneralSectionButton" Style="{StaticResource SettingsSectionButtonStyle}" Content="General" GotFocus="SectionButton_GotFocus" Click="SectionButton_GotFocus" Background="{StaticResource SettingsSectionSelectedBrush}" Foreground="{StaticResource OrbitTextBrush}"/>
                    <Button x:Name="DisplaySectionButton" Style="{StaticResource SettingsSectionButtonStyle}" Content="Display" GotFocus="SectionButton_GotFocus" Click="SectionButton_GotFocus"/>
                    <Button x:Name="InputSectionButton" Style="{StaticResource SettingsSectionButtonStyle}" Content="Input" GotFocus="SectionButton_GotFocus" Click="SectionButton_GotFocus"/>
                </StackPanel>
                <Grid Grid.Column="1" MaxWidth="560" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SectionTitle" Text="General" FontSize="22" Foreground="{StaticResource OrbitTextBrush}" Margin="6,0,0,4"/>
                    <local:AppSettingsControl x:Name="AppSettings" Grid.Row="1"/>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="18" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ContentControl Style="{StaticResource OrbitKeyAStyle}" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Select"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ContentControl Style="{StaticResource OrbitKeyBStyle}" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Back"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        </Grid>
        </Viewbox>
        <!-- Display area calibration, shown while the Display section is open -->
        <Grid x:Name="CalibrationFrame" Margin="{x:Bind State.CalibrationMargin,Mode=OneWay}" IsHitTestVisible="False" Visibility="Collapsed">
            <Border BorderBrush="#99FFFFFF" BorderThickness="2" />
            <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="6,6,0,0" />
            <Border Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="0,6,6,0" />
            <Border Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="6,0,0,6" />
            <Border Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="{StaticResource OrbitFocusBrush}" BorderThickness="0,0,6,6" />
        </Grid>
    </Grid>
</Page>
