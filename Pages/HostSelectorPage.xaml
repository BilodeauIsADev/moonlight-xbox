<Page
    x:Class="moonlight_xbox_dx.HostSelectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:muxm="using:Microsoft.UI.Xaml.Media"
    mc:Ignorable="d"
    Background="{StaticResource OrbitBackgroundBrush}"
    XYFocusKeyboardNavigation="Disabled"
    PreviewKeyDown="Page_PreviewKeyDown" KeyDown="Page_KeyDown" LayoutUpdated="Page_LayoutUpdated" Loaded="Page_Loaded" Unloaded="Page_Unloaded" GotFocus="Page_GotFocus"
    PointerPressed="Page_PointerPressed"
    >
    <FlyoutBase.AttachedFlyout>
        <MenuFlyout AreOpenCloseAnimationsEnabled="False" MenuFlyoutPresenterStyle="{StaticResource OrbitMenuFlyoutPresenterStyle}" x:Name="ActionsFlyout" AllowFocusOnInteraction="false" Placement="TopEdgeAlignedRight">
            <MenuFlyoutItem x:Name="hostSettingsButton" Click="hostSettingsButton_Click" Text="Host Settings" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="hostDetailsButton" Click="hostDetailsButton_Click" Text="Host Details" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="wakeHostButton" Click="wakeHostButton_Click" Text="Wake Host" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="MapDrive" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="testConnectionButton" Click="testConnectionButton_Click" Text="Test Connection" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="removeHostButton" Click="removeHostButton_Click" Text="Remove Host" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Remove" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </FlyoutBase.AttachedFlyout>
    <Grid local:OrbitMotion.Kind="Page">
        <!-- Ambient background: soft glows and light ribbons drifting on a slow loop
             (animated on the compositor from HostSelectorPage::StartAmbient), tinted
             with the focused PC's accent colour. -->
        <Grid x:Name="AmbientLayer" Grid.RowSpan="4" IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF060A18" Offset="0" />
                        <GradientStop Color="#FF02030A" Offset="0.7" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- A Canvas never clips its children; a Grid would clip these oversized
                 shapes to the screen, and the clip edge shows once they drift. The two
                 coloured glows are centred just past the screen corners, so only their
                 soft tails reach the TV's safe area. -->
            <Canvas>
            <Ellipse x:Name="AmbientGlowA" Width="900" Height="640" Canvas.Left="520" Canvas.Top="-300">
                <Ellipse.Fill>
                    <muxm:RadialGradientBrush>
                        <GradientStop x:Name="AmbientGlowAStop" Color="#8C1B3B8A" Offset="0" />
                        <GradientStop Color="#001B3B8A" Offset="1" />
                    </muxm:RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="AmbientGlowB" Width="760" Height="520" Canvas.Left="-400" Canvas.Top="260">
                <Ellipse.Fill>
                    <muxm:RadialGradientBrush>
                        <GradientStop x:Name="AmbientGlowBStop" Color="#591B3B8A" Offset="0" />
                        <GradientStop Color="#001B3B8A" Offset="1" />
                    </muxm:RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="AmbientGlowC" Width="560" Height="420" Canvas.Left="330" Canvas.Top="80">
                <Ellipse.Fill>
                    <muxm:RadialGradientBrush>
                        <GradientStop Color="#1FFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </muxm:RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Two wide ribbons of light, wider than the screen so the drift never shows an end -->
            <Path x:Name="AmbientRibbonA" Width="1600" Height="260" Canvas.Left="-320" Canvas.Top="200" Stretch="Fill"
                  Data="M0,140 C260,40 520,240 800,140 C1080,40 1340,240 1600,140 L1600,170 C1340,270 1080,70 800,170 C520,270 260,70 0,170 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#1F9DB8FF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Path x:Name="AmbientRibbonB" Width="1700" Height="300" Canvas.Left="-370" Canvas.Top="220" Stretch="Fill" Opacity="0.5"
                  Data="M0,160 C300,260 560,60 850,160 C1140,260 1400,60 1700,160 L1700,176 C1400,76 1140,276 850,176 C560,76 300,276 0,176 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.05" />
                        <GradientStop Color="#24FFFFFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="0.95" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            </Canvas>
            <!-- Floating specks, filled in from code -->
            <Canvas x:Name="AmbientParticles" />
            <!-- Keep text readable over the glow -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#99000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.6" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <!-- Interface size: AttachUiScale sizes the content, the Viewbox scales it to fit -->
        <Viewbox Stretch="Fill">
        <Grid x:Name="ScaledRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="32,20,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="ms-appx:///Assets/LunalightMark.png" Width="22" Height="22" />
                <TextBlock Text="Lunalight" FontSize="17" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="36,0,0,0">
                <Button x:Name="hostsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Background="{StaticResource OrbitSurfaceStrongBrush}" Foreground="{StaticResource OrbitTextBrush}" Content="Hosts" />
                <Button x:Name="libraryNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Library" Click="libraryNavButton_Click" />
                <Button x:Name="settingsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Settings" Click="SettingsButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                <Button Style="{StaticResource OrbitCircleButtonStyle}" BorderThickness="0" Background="{StaticResource OrbitSurfaceBrush}" Click="NewHostButton_Click" TabIndex="2" ToolTipService.ToolTip="Add host">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                </Button>
                <Button Name="SettingsButton" Style="{StaticResource OrbitCircleButtonStyle}" BorderThickness="0" Background="{StaticResource OrbitSurfaceBrush}" TabIndex="3" Click="SettingsButton_Click" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Hero: the focused PC, filled in by HostSelectorPage::UpdateHero.
             With no PCs yet it shows the introduction instead. -->
        <StackPanel x:Name="HeroPanel" Grid.Row="1" Margin="32,24,0,0" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HeroStatusDot" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource OrbitRunningBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="HeroEyebrow" Style="{StaticResource OrbitEyebrowTextStyle}" Text="HOSTS" />
            </StackPanel>
            <TextBlock x:Name="HeroName" Style="{StaticResource OrbitTitleTextStyle}" FontSize="40" LineHeight="46" MaxLines="1" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" Text="Your PCs" />
            <TextBlock x:Name="HeroMeta" Margin="0,8,0,0" FontSize="15" Foreground="{StaticResource OrbitTextSecondaryBrush}" TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis"
                       Text="Pick a PC to see its games. PCs running Sunshine on your network show up here on their own." />
            <StackPanel x:Name="HeroButtons" Orientation="Horizontal" Spacing="10" Margin="0,18,0,0" Visibility="Collapsed">
                <Button x:Name="HeroPrimaryButton" Style="{StaticResource OrbitPillButtonStyle}" FontSize="15" Padding="24,8" MinHeight="38" Click="HeroPrimaryButton_Click" Content="Open library" />
                <Button x:Name="HeroOptionsButton" Style="{StaticResource OrbitPillButtonStyle}" FontSize="15" Padding="24,8" MinHeight="38" Background="{StaticResource OrbitSurfaceStrongBrush}" Foreground="{StaticResource OrbitTextBrush}"
                        Click="HeroOptionsButton_Click" Content="PC options" />
            </StackPanel>
        </StackPanel>

        <!-- Host shelf, along the bottom like the Library shelf -->
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,14">
        <TextBlock x:Name="ShelfTitle" Style="{StaticResource OrbitShelfTitleTextStyle}" Text="Your PCs" Margin="32,0,0,0" />
        <Grid HorizontalAlignment="Left" Margin="22,0,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Capped so a long host list scrolls instead of pushing "Add host" off the TV-safe area -->
            <GridView IsRightTapEnabled="True" RightTapped="HostsGrid_RightTapped" x:Name="HostsGrid" ItemsSource="{x:Bind State.SavedHosts}"
                      IsItemClickEnabled="True" ItemClick="GridView_ItemClick" GotFocus="HostsGrid_GotFocus" TabIndex="1" SelectionMode="None"
                      MaxWidth="590"
                      Padding="10,14,0,10"
                      ItemContainerStyle="{StaticResource OrbitHostItemStyle}"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:MoonlightHost" x:DefaultBindMode="OneWay">
                        <StackPanel Width="176">
                            <!-- Accent gradient from the host's name so each PC gets its own card colour -->
                            <Grid Width="176" Height="99" CornerRadius="10" Background="{x:Bind CardBackground}">
                                <!-- When the host reports a running game, its cached artwork fills the card -->
                                <Image Source="{x:Bind PlayingImage}" Stretch="UniformToFill" Visibility="{x:Bind PlayingArtworkVisibility}" />
                                <Grid Background="#B3000000" Visibility="{x:Bind PlayingArtworkVisibility}" />
                                <FontIcon Glyph="&#xE7F4;" FontSize="38" Foreground="#E6FFFFFF" />
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource OrbitWarningBrush}" Visibility="{x:Bind NotPaired}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
                                <Grid Visibility="{x:Bind WolPollingVisibility}" Background="#80000000">
                                    <muxc:ProgressRing IsActive="True" Width="28" Height="28" />
                                </Grid>
                                <Grid Visibility="{x:Bind LoadingVisibility}" Background="#80000000">
                                    <muxc:ProgressRing IsActive="True" Width="28" Height="28" />
                                </Grid>
                                <!-- Asleep or unreachable: dim the card, no spinner -->
                                <Grid Visibility="{x:Bind NotConnected}" Background="#73000000" />
                                <Border Visibility="{x:Bind PlayingArtworkVisibility}" Background="#80000000" CornerRadius="9" Padding="7,2" Margin="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Text="In game" FontSize="11" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{x:Bind ComputerName}" FontSize="14" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind PlayingText}" FontSize="11" Foreground="{StaticResource OrbitRunningBrush}" Margin="0,1,0,0" Visibility="{x:Bind PlayingVisibility}" TextTrimming="CharacterEllipsis" />
                            <!-- No Spacing here: it would still apply around the hidden dot -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Grid Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{StaticResource OrbitRunningBrush}" Visibility="{x:Bind Connected}" />
                                    <Ellipse Fill="#FF888888" Visibility="{x:Bind NotConnected}" />
                                </Grid>
                                <TextBlock FontSize="12" MaxWidth="164" Foreground="{StaticResource OrbitTextTertiaryBrush}" Text="{x:Bind CardStatusText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Margin="4,0,0,0" Foreground="{StaticResource OrbitWarningBrush}" Text="· Not paired" Visibility="{x:Bind NotPaired}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Add host, as the last card in the row -->
            <Button x:Name="AddHostCard" Grid.Column="1" Style="{StaticResource OrbitRowButtonStyle}" Background="Transparent" Padding="0" VerticalAlignment="Top" Margin="0,14,0,0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="NewHostButton_Click">
                <StackPanel Width="176">
                    <Grid Width="176" Height="99">
                        <Rectangle RadiusX="10" RadiusY="10" Fill="#0FFFFFFF" Stroke="#4DFFFFFF" StrokeThickness="1" StrokeDashArray="4,3" />
                        <FontIcon Glyph="&#xE710;" FontSize="26" />
                    </Grid>
                    <TextBlock Text="Add PC" FontSize="14" Margin="0,8,0,0" />
                    <TextBlock Text="Enter an IP or hostname" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource OrbitTextTertiaryBrush}" />
                </StackPanel>
            </Button>

            <!-- First-run checklist: visible while no host has been found, hidden as soon as one appears
                 (managed from Page_LayoutUpdated so it also covers hosts added by discovery). -->
            <StackPanel x:Name="FirstRunChecklist" Grid.Column="2" Orientation="Horizontal" Spacing="36" Margin="44,14,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel Spacing="10" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource OrbitHostChecklistTextStyle}" Text="1  Install Sunshine on your PC" />
                    <TextBlock Style="{StaticResource OrbitHostChecklistTextStyle}" Text="2  Connect both to the same network" />
                    <TextBlock Style="{StaticResource OrbitHostChecklistTextStyle}" Text="3  Pair using the PIN shown here" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <Image Source="ms-appx:///Assets/qrSunshine.svg" Width="96" Height="96" />
                    <TextBlock FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource OrbitTextTertiaryBrush}" Text="Get Sunshine" />
                </StackPanel>
            </StackPanel>
        </Grid>
        </StackPanel>

        <!-- Controller hints -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,32,18">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Style="{StaticResource OrbitKeyLBStyle}" />
                        <FontIcon Style="{StaticResource OrbitKeyRBStyle}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Tabs" />
                </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,0,0,0">
                <FontIcon Style="{StaticResource OrbitKeyAStyle}" />
                <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Open" />
            </StackPanel>
            <!-- Only while the focused PC is offline -->
            <StackPanel x:Name="WakeHint" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" Visibility="Collapsed">
                <FontIcon Style="{StaticResource OrbitKeyXStyle}" />
                <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Wake" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,0,0,0">
                <FontIcon Style="{StaticResource OrbitKeyYStyle}" />
                <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Host options" />
            </StackPanel>
        </StackPanel>
        </Grid>
        </Viewbox>
    </Grid>
</Page>
