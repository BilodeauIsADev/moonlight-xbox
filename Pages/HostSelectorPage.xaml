<Page
    x:Class="moonlight_xbox_dx.HostSelectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{StaticResource OrbitBackgroundBrush}"
    XYFocusKeyboardNavigation="Disabled"
    PreviewKeyDown="Page_PreviewKeyDown" KeyDown="Page_KeyDown" LayoutUpdated="Page_LayoutUpdated"
    PointerPressed="Page_PointerPressed"
    >
    <FlyoutBase.AttachedFlyout>
        <MenuFlyout AreOpenCloseAnimationsEnabled="False" MenuFlyoutPresenterStyle="{StaticResource OrbitMenuFlyoutPresenterStyle}" x:Name="ActionsFlyout" AllowFocusOnInteraction="false" Placement="TopEdgeAlignedRight">
            <MenuFlyoutItem x:Name="hostSettingsButton" Click="hostSettingsButton_Click" Text="Host Settings" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="hostDetailsButton" Click="hostDetailsButton_Click" Text="Host Details" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Help" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="wakeHostButton" Click="wakeHostButton_Click" Text="Wake Host" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="MapDrive" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="testConnectionButton" Click="testConnectionButton_Click" Text="Test Connection" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Globe" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="removeHostButton" Click="removeHostButton_Click" Text="Remove Host" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Remove" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </FlyoutBase.AttachedFlyout>
    <Grid local:OrbitMotion.Kind="Page">
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#FF1B3B8A" Offset="0" />
                <GradientStop Color="#FF0B1530" Offset="0.35" />
                <GradientStop Color="#FF000000" Offset="0.75" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="56,30,56,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="ms-appx:///Assets/LunalightMark.png" Width="22" Height="22" />
                <TextBlock Text="Lunalight" FontSize="17" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="36,0,0,0">
                <Button x:Name="hostsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Background="{StaticResource OrbitSurfaceStrongBrush}" Foreground="{StaticResource OrbitTextBrush}" Content="Hosts" />
                <Button x:Name="libraryNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Library" Click="libraryNavButton_Click" />
                <Button x:Name="settingsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Settings" Click="SettingsButton_Click" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                <Button Style="{StaticResource OrbitCircleButtonStyle}" BorderThickness="0" Background="{StaticResource OrbitSurfaceBrush}" Click="NewHostButton_Click" TabIndex="2" ToolTipService.ToolTip="Add host">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                </Button>
                <Button Name="SettingsButton" Style="{StaticResource OrbitCircleButtonStyle}" BorderThickness="0" Background="{StaticResource OrbitSurfaceBrush}" TabIndex="3" Click="SettingsButton_Click" ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Hero -->
        <StackPanel Grid.Row="1" Margin="56,24,0,0" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource OrbitEyebrowTextStyle}" Text="HOSTS" />
            <TextBlock Style="{StaticResource OrbitTitleTextStyle}" Margin="0,6,0,0" Text="Your PCs" />
            <TextBlock Margin="0,10,0,0" FontSize="15" Foreground="{StaticResource OrbitTextSecondaryBrush}" TextWrapping="WrapWholeWords"
                       Text="Pick a PC to see its games. PCs running Sunshine on your network show up here on their own." />
        </StackPanel>

        <!-- Host shelf -->
        <Grid Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="56,24,56,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Capped so a long host list scrolls instead of pushing "Add host" off the TV-safe area -->
            <GridView IsRightTapEnabled="True" RightTapped="HostsGrid_RightTapped" x:Name="HostsGrid" ItemsSource="{x:Bind State.SavedHosts}"
                      IsItemClickEnabled="True" ItemClick="GridView_ItemClick" GotFocus="HostsGrid_GotFocus" TabIndex="1" SelectionMode="None"
                      MaxWidth="600"
                      Padding="10,14,0,10"
                      ItemContainerStyle="{StaticResource OrbitHostItemStyle}"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:MoonlightHost" x:DefaultBindMode="OneWay">
                        <StackPanel Width="160">
                            <!-- Accent gradient from the host's name so each PC gets its own card colour -->
                            <Grid Width="160" Height="100" CornerRadius="8" Background="{x:Bind CardBackground}">
                                <!-- When the host reports a running game, its cached artwork fills the card -->
                                <Image Source="{x:Bind PlayingImageUri}" Stretch="UniformToFill" Visibility="{x:Bind PlayingArtworkVisibility}" />
                                <Grid Background="#B3000000" Visibility="{x:Bind PlayingArtworkVisibility}" />
                                <FontIcon Glyph="&#xE7F4;" FontSize="38" Foreground="#E6FFFFFF" />
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource OrbitWarningBrush}" Visibility="{x:Bind NotPaired}"
                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
                                <Grid Visibility="{x:Bind WolPollingVisibility}" Background="#80000000">
                                    <muxc:ProgressRing IsActive="True" Width="28" Height="28" />
                                </Grid>
                                <Grid Visibility="{x:Bind LoadingVisibility}" Background="#80000000">
                                    <muxc:ProgressRing IsActive="True" Width="28" Height="28" />
                                </Grid>
                                <!-- Wake gave up: dim the card, no spinner -->
                                <Grid Visibility="{x:Bind TimedOutVisibility}" Background="#66000000" />
                            </Grid>
                            <TextBlock Text="{x:Bind ComputerName}" FontSize="14" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind PlayingText}" FontSize="11" Foreground="{StaticResource OrbitRunningBrush}" Margin="0,1,0,0" Visibility="{x:Bind PlayingVisibility}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource OrbitRunningBrush}" VerticalAlignment="Center" Visibility="{x:Bind Connected}" />
                                <Ellipse Width="6" Height="6" Fill="#FF888888" VerticalAlignment="Center" Visibility="{x:Bind NotConnected}" />
                                <TextBlock FontSize="12" Foreground="{StaticResource OrbitTextTertiaryBrush}" Text="{x:Bind CardStatusText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{StaticResource OrbitWarningBrush}" Text="· Not paired" Visibility="{x:Bind NotPaired}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Add host, as the last card in the row -->
            <Button x:Name="AddHostCard" Grid.Column="1" Style="{StaticResource OrbitRowButtonStyle}" Background="Transparent" Padding="0" VerticalAlignment="Top" Margin="0,14,0,0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" Click="NewHostButton_Click">
                <StackPanel Width="160">
                    <Grid Width="160" Height="100">
                        <Rectangle RadiusX="8" RadiusY="8" Fill="#0FFFFFFF" Stroke="#4DFFFFFF" StrokeThickness="1" StrokeDashArray="4,3" />
                        <FontIcon Glyph="&#xE710;" FontSize="26" />
                    </Grid>
                    <TextBlock Text="Add host" FontSize="14" Margin="0,8,0,0" />
                    <TextBlock Text="Enter an IP or hostname" FontSize="12" Margin="0,2,0,0" Foreground="{StaticResource OrbitTextTertiaryBrush}" />
                </StackPanel>
            </Button>

            <!-- First-run checklist: visible while no host has been found, hidden as soon as one appears
                 (managed from Page_LayoutUpdated so it also covers hosts added by discovery). -->
            <StackPanel x:Name="FirstRunChecklist" Grid.Column="2" Orientation="Horizontal" Spacing="36" Margin="44,14,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel Spacing="10" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource OrbitHostChecklistTextStyle}" Text="1  Install Sunshine on your PC" />
                    <TextBlock Style="{StaticResource OrbitHostChecklistTextStyle}" Text="2  Connect both to the same network" />
                    <TextBlock Style="{StaticResource OrbitHostChecklistTextStyle}" Text="3  Pair using the PIN shown here" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <Image Source="ms-appx:///Assets/qrSunshine.svg" Width="96" Height="96" />
                    <TextBlock FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource OrbitTextTertiaryBrush}" Text="Get Sunshine" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Controller hints -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="20" Margin="0,0,56,30">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="LB / RB" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Tabs" />
                </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Style="{StaticResource OrbitHintGlyphStyle}" Glyph="&#xF093;" Foreground="#FF66CC33" />
                <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Open" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Style="{StaticResource OrbitHintGlyphStyle}" Glyph="&#xF096;" Foreground="#FF3399FF" />
                <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Wake" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Style="{StaticResource OrbitHintGlyphStyle}" Glyph="&#xF095;" Foreground="#FFFFCC33" />
                <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Host options" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
