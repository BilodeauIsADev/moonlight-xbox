<Page
    x:Class="moonlight_xbox_dx.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource OrbitBackgroundBrush}"
    XYFocusKeyboardNavigation="Disabled"
    PreviewKeyDown="Page_PreviewKeyDown" KeyDown="Page_KeyDown"
    >
    <Page.Resources>
        <local:BoolToTextConverter x:Key="BoolToTextConverter" TrueText="On" FalseText="Off" />
    </Page.Resources>
    <FlyoutBase.AttachedFlyout>
        <MenuFlyout AreOpenCloseAnimationsEnabled="False" MenuFlyoutPresenterStyle="{StaticResource OrbitMenuFlyoutPresenterStyle}" x:Name="ActionsFlyout" AllowFocusOnInteraction="false" Placement="TopEdgeAlignedRight">
            <MenuFlyoutItem x:Name="resumeAppButton" Click="resumeAppButton_Click" Text="Resume App" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="closeAppButton"  Click="closeAppButton_Click"  Text="Close App" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Stop" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="closeAndStartButton"  Click="closeAndStartButton_Click"  Text="Close Current App and Start" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Next" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </FlyoutBase.AttachedFlyout>
    <!-- Interface size: AttachUiScale sizes the content, the Viewbox scales it to fit -->
    <Viewbox Stretch="Fill">
        <Grid x:Name="ScaledRoot" local:OrbitMotion.Kind="Page">
            <!-- Wide artwork for the highlighted game, faded into the page behind the controls -->
            <Grid IsHitTestVisible="False">
                <Grid x:Name="HeroArtLayers" Opacity="0.9" />
                <!-- Soft left edge so the art never shows a hard seam -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF000000" Offset="0" />
                            <GradientStop Color="#B3000000" Offset="0.22" />
                            <GradientStop Color="#00000000" Offset="0.55" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <Rectangle Fill="{StaticResource OrbitHeroLeftFadeBrush}" IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource OrbitHeroBottomFadeBrush}" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar: tabs centred between the bumpers, clock on the right -->
                <Grid Grid.Row="0" Margin="32,18,32,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                        <ContentControl Style="{StaticResource OrbitKeyLBStyle}" Margin="0,0,6,0" />
                        <Button x:Name="hostsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Hosts" Click="backButton_Click" />
                        <Button x:Name="libraryNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Library" Background="{StaticResource OrbitTabSelectedBrush}" Foreground="{StaticResource OrbitTabSelectedTextBrush}" />
                        <Button x:Name="settingsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Settings" Click="settingsButton_Click" />
                        <ContentControl Style="{StaticResource OrbitKeyRBStyle}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ClockText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource OrbitTextBrush}" />
                </Grid>

                <!-- Hero: whatever app is focused in the shelf, centred in the space above it -->
                <StackPanel Grid.Row="1" Margin="32,0,0,0" MaxWidth="470" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource OrbitRunningBrush}" VerticalAlignment="Center" Visibility="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource OrbitEyebrowTextStyle}">
                            <Run Text="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='RUNNING ON|ON'}" /><Run Text=" " /><Run Text="{x:Bind Host.ComputerName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Grid x:Name="HeroIdentity" Width="440" Height="112" Margin="0,6,0,0" HorizontalAlignment="Left">
                        <TextBlock x:Name="HeroTitle" Style="{StaticResource OrbitTitleTextStyle}" VerticalAlignment="Center" Text="{x:Bind SelectedApp.Name, Mode=OneWay}" />
                        <Grid x:Name="HeroLogoLayers" IsHitTestVisible="False" AutomationProperties.Name="{x:Bind SelectedApp.Name, Mode=OneWay}" />
                    </Grid>
                    <TextBlock x:Name="StreamSummaryText" Margin="0,10,0,0" FontSize="15" Foreground="{StaticResource OrbitTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- App shelf -->
                <StackPanel Grid.Row="2" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource OrbitShelfTitleTextStyle}" Margin="32,0,0,0">
                        <Run Text="On " /><Run Text="{x:Bind Host.ComputerName, Mode=OneWay}" />
                    </TextBlock>
                    <!-- Placeholder posters with a soft pulse while the app list loads -->
                    <StackPanel x:Name="ShelfLoadingPanel" Orientation="Horizontal" Margin="32,14,32,10" Visibility="Collapsed">
                        <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                        <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                        <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                        <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                        <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                        <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                    </StackPanel>
                    <GridView x:Name="HostsGrid" ItemsSource="{x:Bind Host.Apps}" IsRightTapEnabled="True" IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="AppsGrid_ItemClick" RightTapped="AppsGrid_RightTapped" GotFocus="AppsGrid_GotFocus" TabIndex="1"
                              Padding="32,14,32,10"
                              ItemContainerStyle="{StaticResource OrbitPosterItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:MoonlightApp" x:DefaultBindMode="OneWay">
                                <StackPanel Width="128" Background="Transparent" PointerEntered="AppTile_PointerEntered">
                                    <Grid Width="128" Height="128" CornerRadius="6" Background="{StaticResource OrbitSurfaceBrush}">
                                        <Image Source="{x:Bind ImagePath}" Stretch="UniformToFill" />
                                        <Border Visibility="{x:Bind CurrentlyRunning}" Background="{StaticResource OrbitRunningBrush}" CornerRadius="4" Padding="5,1" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="RUNNING" FontSize="10" FontWeight="SemiBold" Foreground="#FF04220F" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" Margin="0,6,0,0" Foreground="{StaticResource OrbitTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <!-- Shown when the host reports no apps at all -->
                    <StackPanel x:Name="ShelfEmptyPanel" Margin="32,14,32,10" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OrbitShelfTitleTextStyle}" Text="No apps on this host" />
                        <TextBlock Text="Add games in Sunshine's Applications page, then come back."
                                   FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"
                                   Foreground="{StaticResource OrbitTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Jump-to-letter picker (View button): centred over the dimmed page so it
                     keeps the game identity and shelf position clear -->
                <Grid x:Name="LetterJumpPanel" Grid.RowSpan="4" Visibility="Collapsed" Background="#B3000000">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,12" CornerRadius="12"
                            Background="{StaticResource OrbitPanelBrush}" BorderBrush="{StaticResource OrbitOverlayBorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource OrbitEyebrowTextStyle}" Text="JUMP TO LETTER" Margin="4,0,0,10" />
                            <!-- Wraps after 14 letters so the whole alphabet fits the TV-safe width -->
                            <VariableSizedWrapGrid x:Name="LetterJumpRow" Orientation="Horizontal" MaximumRowsOrColumns="14" ItemWidth="44" ItemHeight="44" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Controller hints: page-wide moves on the left, actions on the right.
                     Margins rather than Spacing so hidden hints leave no gap. -->
                <Grid Grid.Row="3" Margin="32,0,32,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel x:Name="PageHint" Orientation="Horizontal" Spacing="5" Margin="0,0,18,0">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ContentControl Style="{StaticResource OrbitKeyLTStyle}" />
                                <ContentControl Style="{StaticResource OrbitKeyRTStyle}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Page" />
                        </StackPanel>
                        <StackPanel x:Name="JumpHint" Orientation="Horizontal" Spacing="5" Margin="0,0,18,0" Visibility="Collapsed">
                            <ContentControl Style="{StaticResource OrbitKeyViewStyle}" />
                            <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Jump to letter" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel x:Name="StreamHint" Orientation="Horizontal" Spacing="5" Margin="18,0,0,0">
                            <ContentControl Style="{StaticResource OrbitKeyAStyle}" />
                            <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Resume|Play'}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="18,0,0,0" Visibility="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay}">
                            <ContentControl Style="{StaticResource OrbitKeyXStyle}" />
                            <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Close app" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="18,0,0,0">
                            <ContentControl Style="{StaticResource OrbitKeyYStyle}" />
                            <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Stream settings" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Closing screen: the game's artwork with progress, like the stream's
                 loading and end-of-session screens -->
            <Grid x:Name="ClosingView" Background="{StaticResource OrbitBackgroundBrush}" Visibility="Collapsed">
                <Image Source="{x:Bind ClosingArtPath, Mode=OneWay}" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.75" />
                <Rectangle Fill="{StaticResource OrbitHeroLeftFadeBrush}" />
                <Rectangle Fill="{StaticResource OrbitHeroBottomFadeBrush}" />
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="64,0,64,48" MaxWidth="620">
                    <TextBlock Style="{StaticResource OrbitEyebrowTextStyle}" Text="CLOSING GAME" />
                    <TextBlock x:Name="ClosingTitleText" Style="{StaticResource OrbitTitleTextStyle}" FontSize="44" LineHeight="48" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
                        <muxc:ProgressRing Width="22" Height="22" IsActive="{x:Bind ClosingApp, Mode=OneWay}" Foreground="{StaticResource OrbitTextBrush}" />
                        <TextBlock x:Name="ClosingStatusText" FontSize="16" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Page>
