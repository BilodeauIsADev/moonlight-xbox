<Page
    x:Class="moonlight_xbox_dx.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:moonlight_xbox_dx"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource OrbitBackgroundBrush}"
    XYFocusKeyboardNavigation="Disabled"
    PreviewKeyDown="Page_PreviewKeyDown" KeyDown="Page_KeyDown"
    >
    <Page.Resources>
        <local:BoolToTextConverter x:Key="BoolToTextConverter" TrueText="On" FalseText="Off" />
    </Page.Resources>
    <FlyoutBase.AttachedFlyout>
        <MenuFlyout AreOpenCloseAnimationsEnabled="False" MenuFlyoutPresenterStyle="{StaticResource OrbitMenuFlyoutPresenterStyle}" x:Name="ActionsFlyout" AllowFocusOnInteraction="false" Placement="TopEdgeAlignedRight">
            <MenuFlyoutItem x:Name="resumeAppButton" Click="resumeAppButton_Click" Text="Resume App" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Play" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="closeAppButton"  Click="closeAppButton_Click"  Text="Close App" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Stop" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="closeAndStartButton"  Click="closeAndStartButton_Click"  Text="Close Current App and Start" AllowFocusOnInteraction="false" FocusVisualSecondaryThickness="0.5" >
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Next" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </FlyoutBase.AttachedFlyout>
    <Grid local:OrbitMotion.Kind="Page">
        <!-- Wide artwork for the highlighted game, faded into the page behind the controls -->
        <Grid IsHitTestVisible="False">
            <Grid x:Name="HeroArtLayers" Opacity="0.9" />
            <!-- Soft left edge so the art never shows a hard seam -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#B3000000" Offset="0.22" />
                        <GradientStop Color="#00000000" Offset="0.55" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Rectangle Fill="{StaticResource OrbitHeroLeftFadeBrush}" IsHitTestVisible="False" />
        <Rectangle Fill="{StaticResource OrbitHeroBottomFadeBrush}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="56,30,56,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Image Source="ms-appx:///Assets/LunalightMark.png" Width="22" Height="22" />
                    <TextBlock Text="Lunalight" FontSize="17" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="36,0,0,0">
                    <Button x:Name="hostsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Hosts" Click="backButton_Click" />
                    <Button x:Name="libraryNavButton" Style="{StaticResource OrbitNavButtonStyle}" Background="{StaticResource OrbitSurfaceStrongBrush}" Foreground="{StaticResource OrbitTextBrush}" Content="Library" />
                    <Button x:Name="settingsNavButton" Style="{StaticResource OrbitNavButtonStyle}" Content="Settings" Click="settingsButton_Click" />
                </StackPanel>
                <Button Grid.Column="3" x:Name="settingsButton" Style="{StaticResource OrbitCircleButtonStyle}" BorderThickness="0" Background="{StaticResource OrbitSurfaceBrush}" Click="settingsButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </Grid>

            <!-- Hero: whatever app is focused in the shelf -->
            <StackPanel Grid.Row="1" Margin="56,12,0,0" MaxWidth="470" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource OrbitRunningBrush}" VerticalAlignment="Center" Visibility="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource OrbitEyebrowTextStyle}">
                        <Run Text="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='RUNNING ON|ON'}" /><Run Text=" " /><Run Text="{x:Bind Host.ComputerName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Grid x:Name="HeroIdentity" Width="440" Height="112" Margin="0,6,0,0" HorizontalAlignment="Left">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource OrbitTitleTextStyle}" VerticalAlignment="Center" Text="{x:Bind SelectedApp.Name, Mode=OneWay}" />
                    <Grid x:Name="HeroLogoLayers" IsHitTestVisible="False" AutomationProperties.Name="{x:Bind SelectedApp.Name, Mode=OneWay}" />
                </Grid>
                <TextBlock x:Name="StreamSummaryText" Margin="0,10,0,0" FontSize="15" Foreground="{StaticResource OrbitTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,18,0,0">
                    <Button x:Name="primaryButton" Style="{StaticResource OrbitPillButtonStyle}" Click="primaryButton_Click"
                            Content="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Resume|Start streaming'}" />
                    <Button x:Name="heroCloseAppButton" Style="{StaticResource OrbitCircleButtonStyle}" Click="closeAppButton_Click"
                            Visibility="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay}" ToolTipService.ToolTip="Close app">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- App shelf -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource OrbitShelfTitleTextStyle}" Margin="56,0,0,0">
                    <Run Text="On " /><Run Text="{x:Bind Host.ComputerName, Mode=OneWay}" />
                </TextBlock>
                <!-- Placeholder posters with a soft pulse while the app list loads -->
                <StackPanel x:Name="ShelfLoadingPanel" Orientation="Horizontal" Margin="56,14,56,10" Visibility="Collapsed">
                    <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                    <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                    <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                    <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                    <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                    <Grid Style="{StaticResource OrbitShelfPlaceholderStyle}" />
                </StackPanel>
                <GridView x:Name="HostsGrid" ItemsSource="{x:Bind Host.Apps}" IsRightTapEnabled="True" IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="AppsGrid_ItemClick" RightTapped="AppsGrid_RightTapped" GotFocus="AppsGrid_GotFocus" TabIndex="1"
                          Padding="56,14,56,10"
                          ItemContainerStyle="{StaticResource OrbitPosterItemStyle}"
                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:MoonlightApp" x:DefaultBindMode="OneWay">
                            <StackPanel Width="128" Background="Transparent" PointerEntered="AppTile_PointerEntered">
                                <Grid Width="128" Height="128" CornerRadius="6" Background="{StaticResource OrbitSurfaceBrush}">
                                    <Image Source="{x:Bind ImagePath}" Stretch="UniformToFill" />
                                    <Border Visibility="{x:Bind CurrentlyRunning}" Background="{StaticResource OrbitRunningBrush}" CornerRadius="4" Padding="5,1" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="RUNNING" FontSize="10" FontWeight="SemiBold" Foreground="#FF04220F" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" FontSize="13" Margin="0,6,0,0" Foreground="{StaticResource OrbitTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <!-- Shown when the host reports no apps at all -->
                <StackPanel x:Name="ShelfEmptyPanel" Margin="56,14,56,10" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource OrbitShelfTitleTextStyle}" Text="No apps on this host" />
                    <TextBlock Text="Add games in Sunshine's Applications page, then come back."
                               FontSize="14" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="470" HorizontalAlignment="Left"
                               Foreground="{StaticResource OrbitTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Jump-to-letter picker (View button), floating above the shelf -->
            <Border x:Name="LetterJumpPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,12" Padding="12,8" CornerRadius="10" Visibility="Collapsed"
                    Background="{StaticResource OrbitPanelBrush}" BorderBrush="{StaticResource OrbitOverlayBorderBrush}" BorderThickness="1">
                <!-- Wraps after 14 letters so the whole alphabet fits the TV-safe width -->
                <VariableSizedWrapGrid x:Name="LetterJumpRow" Orientation="Horizontal" MaximumRowsOrColumns="14" ItemWidth="44" ItemHeight="44" />
            </Border>

            <!-- Controller hints -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="20" Margin="0,0,56,30">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ContentControl Style="{StaticResource OrbitKeyPillStyle}" Content="LB" />
                        <ContentControl Style="{StaticResource OrbitKeyPillStyle}" Content="RB" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Tabs" />
                </StackPanel>
                <StackPanel x:Name="PageHint" Orientation="Horizontal" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <ContentControl Style="{StaticResource OrbitKeyPillStyle}" Content="LT" />
                        <ContentControl Style="{StaticResource OrbitKeyPillStyle}" Content="RT" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Games" />
                </StackPanel>
                <StackPanel x:Name="StreamHint" Orientation="Horizontal" Spacing="6">
                    <ContentControl Style="{StaticResource OrbitKeyCapStyle}" Content="A" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Stream" />
                </StackPanel>
                <StackPanel x:Name="JumpHint" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <ContentControl Style="{StaticResource OrbitKeyGlyphCapStyle}" Content="&#xEECA;" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Jump to letter" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind SelectedApp.CurrentlyRunning, Mode=OneWay}">
                    <ContentControl Style="{StaticResource OrbitKeyCapStyle}" Content="X" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Close app" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ContentControl Style="{StaticResource OrbitKeyCapStyle}" Content="Y" />
                    <TextBlock Style="{StaticResource OrbitHintTextStyle}" Text="Settings" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
