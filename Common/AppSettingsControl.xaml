<UserControl
    x:Class="moonlight_xbox_dx.AppSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    XYFocusKeyboardNavigation="Enabled">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SettingsCardBrush" Color="#D9141416"/>
        <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardFocusedBrush" Color="#3DFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCardFocusedBorderBrush" Color="#CCFFFFFF"/>
        <!-- Option card: dark glass; the card holding focus lights up -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="50"/>
        </Style>
        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource OrbitTextBrush}"/>
        </Style>
        <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource OrbitTextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsIntroStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="Foreground" Value="{StaticResource OrbitTextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource OrbitComboBoxStyle}">
            <Setter Property="Width" Value="220"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Width" Value="220"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OrbitFocusBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
        <Style TargetType="ToggleSwitch">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OrbitFocusBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OrbitFocusBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="ContentScroll" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" IsTabStop="False" Padding="6,4,10,6">
        <StackPanel>
            <StackPanel x:Name="GeneralPanel" Spacing="8" Visibility="Visible">
                <TextBlock x:Name="GeneralHeading" Text="General" FontSize="22" Foreground="{StaticResource OrbitTextBrush}" Margin="0,8,0,4"/>
                <TextBlock Style="{StaticResource SettingsIntroStyle}" Margin="0,0,0,10" Text="Resolution, frame rate and bitrate are set per PC: press Y in a PC's library to change them."/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Autostart host"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox x:Name="HostSelector" SelectionChanged="HostSelector_SelectionChanged" AutomationProperties.Name="Autostart host"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Welcome wizard"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="WelcomeButton" Click="WelcomeButton_Click" AutomationProperties.Name="Open Welcome Wizard" Style="{StaticResource OrbitPillButtonStyle}" FontSize="15" Padding="16,8" HorizontalAlignment="Right">Open Welcome Wizard</Button>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Navigation sounds"/>
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Play the console's sounds when moving focus and selecting."/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="NavigationSoundsToggle" IsOn="{x:Bind State.NavigationSounds,Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" AutomationProperties.Name="Navigation sounds"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel x:Name="DisplayPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="DisplayHeading" Text="Display" FontSize="22" Foreground="{StaticResource OrbitTextBrush}" Margin="0,28,0,4"/>
                <TextBlock Style="{StaticResource SettingsIntroStyle}" Margin="0,0,0,10" Text="Your TV may crop the edges of the picture. Adjust the margins until the whole white outline and its corner marks are visible."/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Interface size"/>
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Size of the menus. The stream itself is not affected."/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox x:Name="UiScaleSelector" SelectionChanged="UiScaleSelector_SelectionChanged" AutomationProperties.Name="Interface size">
                                <ComboBoxItem Content="Large (100%)" Tag="100"/>
                                <ComboBoxItem Content="Medium (90%)" Tag="90"/>
                                <ComboBoxItem Content="Small (80%)" Tag="80"/>
                            </ComboBox>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Screen margin height"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Slider Value="{x:Bind State.ScreenMarginHeight}" x:DefaultBindMode="TwoWay" Minimum="0" Maximum="100" StepFrequency="1" x:Name="ScreenMarginHeightSlider" AutomationProperties.Name="Screen margin height"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Screen margin width"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Slider Value="{x:Bind State.ScreenMarginWidth}" x:DefaultBindMode="TwoWay" Minimum="0" Maximum="100" StepFrequency="1" x:Name="ScreenMarginWidthSlider" AutomationProperties.Name="Screen margin width"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Use for menus too"/>
                            <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Text="Also inset the Hosts, Library and Settings screens. The stream always uses the margin."/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch x:Name="MenuSafeAreaToggle" IsOn="{x:Bind State.MenuSafeArea,Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" AutomationProperties.Name="Use the screen margin for menus"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel x:Name="InputPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="InputHeading" Text="Input" FontSize="22" Foreground="{StaticResource OrbitTextBrush}" Margin="0,28,0,4"/>
                <TextBlock Style="{StaticResource SettingsIntroStyle}" Margin="0,0,0,10" Text="How the controller drives the mouse and keyboard on your PC while streaming."/>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Mouse sensitivity"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Slider Value="{x:Bind State.MouseSensitivity}" x:DefaultBindMode="TwoWay" Minimum="1" Maximum="16" StepFrequency="1" x:Name="MouseSensitivitySlider" AutomationProperties.Name="Mouse sensitivity"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Experimental keyboard"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ToggleSwitch Name="KeyboardEnable" XYFocusRight="{x:Bind KeyboardLayoutSelector}" IsOn="{x:Bind State.EnableKeyboard,Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" AutomationProperties.Name="Experimental keyboard"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Style="{StaticResource SettingsRowTitleStyle}" Text="Keyboard layout"/>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ComboBox x:Name="KeyboardLayoutSelector" SelectionChanged="LayoutSelector_SelectionChanged" AutomationProperties.Name="Keyboard layout"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
